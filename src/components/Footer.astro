---
const currentYear = new Date().getFullYear();

const links = [
  { name: 'About', href: '/#about' },
  { name: 'Projects', href: '/#projects' },
  { name: 'Collaborate', href: '/#collaborate' },
  { name: 'Contact', href: '/contact' },
  { name: 'Imprint', href: '/imprint' },
  { name: 'Privacy', href: '/privacy' },
];

const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/Cyb3rDudu',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.59 2 12.253c0 4.53 2.865 8.371 6.839 9.727.5.094.683-.222.683-.494 0-.244-.009-.89-.014-1.747-2.782.62-3.369-1.375-3.369-1.375-.455-1.184-1.11-1.5-1.11-1.5-.908-.636.069-.623.069-.623 1.004.073 1.532 1.057 1.532 1.057.892 1.566 2.341 1.114 2.91.852.091-.663.349-1.114.635-1.37-2.221-.259-4.555-1.138-4.555-5.064 0-1.118.39-2.033 1.03-2.75-.103-.26-.446-1.302.098-2.713 0 0 .84-.276 2.75 1.05A9.402 9.402 0 0112 6.992c.85.004 1.705.118 2.504.347 1.909-1.326 2.747-1.05 2.747-1.05.546 1.411.203 2.454.1 2.713.64.717 1.028 1.632 1.028 2.75 0 3.936-2.337 4.802-4.566 5.056.359.318.679.946.679 1.906 0 1.376-.013 2.486-.013 2.824 0 .274.18.593.688.493C21.138 20.62 24 16.782 24 12.253 24 6.59 19.523 2 14 2h-2z" clip-rule="evenodd"/></svg>`
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/%E2%96%BAjan-m%C3%BCller-3b0a18177/',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`
  },
];
---

<footer class="border-t border-white/5 bg-midnight/60">
  <div class="container-custom py-12">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <a href="/" class="flex items-center gap-3 mb-5">
          <div class="text-white font-bold text-xl">catdev</div>
        </a>
        <p class="text-steel max-w-2xl leading-relaxed">
          Jan Mueller builds across AI, cybersecurity, programming, DevOps, infrastructure,
          and the hardware edges where software meets the real world.
        </p>

        <div class="flex items-center gap-4 mt-6">
          {socialLinks.map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-steel hover:text-cyan transition-colors"
              aria-label={social.name}
            >
              <div set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <div class="lg:text-right">
        <div class="flex flex-wrap gap-x-5 gap-y-3 lg:justify-end mb-6">
          {links.map(link => (
            <a href={link.href} class="text-sm text-steel hover:text-white transition-colors">
              {link.name}
            </a>
          ))}
        </div>

        <div class="text-steel text-sm space-y-2">
          <p class="font-semibold text-white">CATDEV LLC</p>
          <p>7901 4th St N STE 300, St. Petersburg, FL 33702, USA</p>
          <a href="mailto:info@catdev.io" class="text-cyan hover:text-white transition-colors inline-block">
            info@catdev.io
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-steel text-sm">
        &copy; {currentYear} CATDEV LLC. All rights reserved.
      </p>
      <p class="text-steel text-sm">
        Built around systems, security, AI, and curiosity.
      </p>
    </div>
  </div>
</footer>
