---
const currentYear = new Date().getFullYear();
const columns = [
  { title: 'Capabilities', links: [{ name: 'Services', href: '/services' }, { name: 'Solutions', href: '/solutions' }, { name: 'Partners', href: '/partners' }] },
  { title: 'Company', links: [{ name: 'Case Studies', href: '/case-studies' }, { name: 'Company', href: '/company' }, { name: 'Contact', href: '/contact' }] },
  { title: 'Legal', links: [{ name: 'Imprint', href: '/imprint' }, { name: 'Privacy', href: '/privacy' }] },
];
---

<footer class="border-t border-white/10 bg-[#060916]">
  <div class="container-custom py-14 md:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.35fr_1fr]">
      <div>
        <a href="/" class="mb-5 inline-flex items-center gap-3" aria-label="Catdev home">
          <span class="brand-mark h-11 w-[3.5rem]" aria-hidden="true"></span>
          <span class="brand-wordmark h-[1.3rem] w-[6.75rem]" aria-hidden="true"></span>
        </a>
        <p class="max-w-xl text-lg leading-relaxed text-steel">Enterprise technology engineering across cloud platforms, security and the delivery lifecycle of enterprise software.</p>
        <a href="mailto:info@catdev.io" class="mt-6 inline-block text-cyan transition-colors hover:text-white">info@catdev.io</a>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {columns.map((column) => (
          <div>
            <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-white">{column.title}</h2>
            <ul class="space-y-3">
              {column.links.map((link) => <li><a href={link.href} class="text-sm text-steel transition-colors hover:text-white">{link.name}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-7 text-sm text-steel md:flex-row md:items-center md:justify-between">
      <p>&copy; {currentYear} CATDEV LLC. All rights reserved.</p>
      <p>Engineering secure enterprise technology.</p>
    </div>
  </div>
</footer>
