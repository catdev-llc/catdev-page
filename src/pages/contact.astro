---
import Layout from '../layouts/Layout.astro';

const topics = [
  'AI and agent tooling',
  'Cybersecurity or pentesting automation',
  'Infrastructure, DevOps, or Kubernetes',
  'Research systems and RAG',
  'Open source collaboration',
  'Something weird and technical',
];
---

<Layout
  title="Contact - catdev"
  description="Contact Jan Mueller about collaboration around AI, cybersecurity, programming, DevOps, infrastructure, and agentic systems."
>
  <section class="section-padding relative overflow-hidden pt-32">
    <div class="absolute inset-0 bg-gradient-radial from-electric/10 via-transparent to-transparent"></div>
    <div class="absolute inset-0 hexagon-pattern opacity-20"></div>

    <div class="container-custom relative">
      <div class="max-w-5xl mx-auto reveal">
        <div class="text-center mb-12">
          <p class="text-cyan font-mono text-sm mb-4">contact</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            <span class="text-white">Start a technical</span>
            <span class="text-gradient"> conversation.</span>
          </h1>
          <p class="text-xl text-steel max-w-3xl mx-auto leading-relaxed">
            I am open to collaboration around AI, cybersecurity, programming,
            DevOps, infrastructure, hardware tinkering, and unusual systems work.
          </p>
        </div>

        <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-8">
          <div class="card-glass p-8">
            <div class="glow-effect"></div>
            <div class="relative z-10">
              <h2 class="text-xl font-semibold text-white mb-6">Send a message</h2>
              <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
                <input type="hidden" name="access_key" value="13d183f9-2567-484a-ab30-2bffe705bdd2" />
                <input type="hidden" name="subject" value="New Contact from catdev.io" />
                <input type="hidden" name="from_name" value="catdev.io Contact Form" />
                <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <label for="name" class="block text-sm text-steel mb-2">Name *</label>
                    <input
                      type="text"
                      id="name"
                      name="name"
                      required
                      class="w-full px-4 py-3 bg-midnight/50 border border-steel/20 rounded-lg text-white placeholder-steel/50 focus:border-cyan focus:outline-none transition-colors"
                      placeholder="Your name"
                    />
                  </div>
                  <div>
                    <label for="email" class="block text-sm text-steel mb-2">Email *</label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="w-full px-4 py-3 bg-midnight/50 border border-steel/20 rounded-lg text-white placeholder-steel/50 focus:border-cyan focus:outline-none transition-colors"
                      placeholder="you@example.com"
                    />
                  </div>
                </div>

                <div>
                  <label for="topic" class="block text-sm text-steel mb-2">Topic</label>
                  <select
                    id="topic"
                    name="topic"
                    class="w-full px-4 py-3 bg-midnight/50 border border-steel/20 rounded-lg text-white focus:border-cyan focus:outline-none transition-colors"
                  >
                    {topics.map(topic => (
                      <option value={topic}>{topic}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label for="message" class="block text-sm text-steel mb-2">Message *</label>
                  <textarea
                    id="message"
                    name="message"
                    required
                    rows="6"
                    class="w-full px-4 py-3 bg-midnight/50 border border-steel/20 rounded-lg text-white placeholder-steel/50 focus:border-cyan focus:outline-none transition-colors resize-none"
                    placeholder="Tell me what you are building, researching, or trying to solve."
                  ></textarea>
                </div>

                <button type="submit" class="btn-secondary w-full justify-center">
                  Send Message
                </button>
              </form>

              <div id="form-success" class="hidden mt-4 p-4 bg-green-500/20 border border-green-500/50 rounded-lg text-green-400 text-center">
                Message sent. I will get back to you.
              </div>
              <div id="form-error" class="hidden mt-4 p-4 bg-red-500/20 border border-red-500/50 rounded-lg text-red-400 text-center">
                Something went wrong. Please email info@catdev.io directly.
              </div>
            </div>
          </div>

          <aside class="space-y-6">
            <div class="card-glass p-8">
              <div class="glow-effect"></div>
              <div class="relative z-10">
                <h2 class="text-xl font-semibold text-white mb-4">Best fit</h2>
                <ul class="space-y-3">
                  {topics.map(topic => (
                    <li class="flex gap-3 text-steel">
                      <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-cyan"></span>
                      <span>{topic}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="rounded-lg border border-white/10 bg-white/[0.03] p-8">
              <h2 class="text-xl font-semibold text-white mb-4">Direct links</h2>
              <div class="flex flex-col gap-3">
                <a href="mailto:info@catdev.io" class="text-cyan hover:text-white transition-colors">info@catdev.io</a>
                <a href="https://github.com/Cyb3rDudu" target="_blank" rel="noopener noreferrer" class="text-cyan hover:text-white transition-colors">github.com/Cyb3rDudu</a>
                <a href="https://www.linkedin.com/in/%E2%96%BAjan-m%C3%BCller-3b0a18177/" target="_blank" rel="noopener noreferrer" class="text-cyan hover:text-white transition-colors">LinkedIn profile</a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form as HTMLFormElement);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');
      } else {
        errorMsg?.classList.remove('hidden');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
    }
  });
</script>
