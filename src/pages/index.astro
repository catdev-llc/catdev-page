---
import Layout from '../layouts/Layout.astro';
import { caseStudies, engineeringProjects, services, solutions, trustSignals } from '../data/enterprise';
---

<Layout title="Catdev | Enterprise Technology Engineering" description="Catdev provides cloud, security and enterprise technology services—from architecture and implementation to integration and ongoing operations.">
  <section class="enterprise-grid relative overflow-hidden border-b border-white/10 pt-32 md:pt-40">
    <div class="absolute left-[58%] top-20 h-80 w-80 rounded-full bg-electric/10 blur-3xl"></div>
    <div class="container-custom relative pb-20 md:pb-28">
      <div class="grid items-center gap-14 lg:grid-cols-[1.12fr_0.88fr] lg:gap-20">
        <div class="reveal">
          <p class="eyebrow">Enterprise Technology Engineering</p>
          <h1 class="max-w-4xl text-5xl font-semibold leading-[1.02] tracking-[-0.035em] text-white md:text-7xl">
            Engineering secure enterprise technology.
          </h1>
          <p class="mt-7 max-w-3xl text-xl leading-relaxed text-steel md:text-2xl">
            Catdev provides cloud, security and enterprise technology services for organizations operating complex and business-critical systems.
          </p>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-steel">
            From architecture and implementation to integration and ongoing operations, we help organizations modernize infrastructure, strengthen security and deploy enterprise technology successfully.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="/services" class="btn-primary">Explore our services</a>
            <a href="/contact" class="btn-secondary">Discuss a project</a>
          </div>
        </div>

        <div class="reveal" style="transition-delay: 100ms">
          <div class="rounded-lg border border-white/10 bg-[#0d1430]/90 p-2 shadow-2xl shadow-black/30">
            <div class="border-b border-white/10 px-5 py-4">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-steel">Delivery lifecycle</p>
            </div>
            <ol class="divide-y divide-white/10">
              {['Architecture', 'Implementation', 'Integration', 'Operations'].map((step, index) => (
                <li class="flex items-center gap-5 px-5 py-5">
                  <span class="font-mono text-sm text-cyan">0{index + 1}</span>
                  <span class="text-lg font-medium text-white">{step}</span>
                  <span class="ml-auto h-px w-10 bg-gradient-to-r from-cyan/60 to-transparent"></span>
                </li>
              ))}
            </ol>
            <div class="m-2 rounded-md border border-cyan/20 bg-cyan/[0.05] p-5 text-sm leading-relaxed text-steel">
              Senior engineering ownership from initial technical decisions through production handover and lifecycle support.
            </div>
          </div>
        </div>
      </div>

      <div class="mt-16 grid border-y border-white/10 sm:grid-cols-3">
        {trustSignals.map((signal, index) => (
          <div class:list={['px-0 py-5 sm:px-6', index > 0 && 'border-t border-white/10 sm:border-l sm:border-t-0']}>
            <p class="font-semibold text-white">{signal.value}</p>
            <p class="mt-1 text-sm leading-relaxed text-steel">{signal.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding" id="services">
    <div class="container-custom">
      <div class="max-w-3xl reveal">
        <p class="eyebrow">Core services</p>
        <h2 class="section-title">Technical depth where enterprise systems meet production reality.</h2>
        <p class="section-copy mt-6">Three connected service areas cover the platform, its security and the enterprise technology running on it.</p>
      </div>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {services.map((service, index) => (
          <article class="card-glass flex min-h-full flex-col p-7 reveal" style={`transition-delay:${index * 80}ms`}>
            <div class="mb-8 flex items-center justify-between">
              <span class="font-mono text-sm text-cyan">{service.number}</span>
              <span class="h-px w-16 bg-gradient-to-r from-cyan/50 to-transparent"></span>
            </div>
            <h3 class="text-2xl font-semibold text-white">{service.title}</h3>
            <p class="mt-4 leading-relaxed text-steel">{service.summary}</p>
            <ul class="mt-7 space-y-2.5 border-t border-white/10 pt-6">
              {service.capabilities.map((item) => <li class="flex gap-3 text-sm text-steel"><span class="text-cyan">—</span>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <a href="/services" class="mt-8 inline-flex items-center gap-2 font-semibold text-cyan transition-colors hover:text-white">View service details <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.02] section-padding" id="solutions">
    <div class="container-custom">
      <div class="grid gap-12 lg:grid-cols-[0.76fr_1.24fr] lg:gap-20">
        <div class="reveal">
          <p class="eyebrow">Solutions</p>
          <h2 class="section-title">Organized around the problem, not the toolchain.</h2>
          <p class="section-copy mt-6">Focused engagements combine architecture, implementation and operational thinking around a clear customer outcome.</p>
          <a href="/solutions" class="btn-secondary mt-8">Explore solutions</a>
        </div>
        <div class="grid gap-px overflow-hidden rounded-lg border border-white/10 bg-white/10 sm:grid-cols-2 reveal">
          {solutions.map((solution) => (
            <article class="bg-midnight p-7">
              <h3 class="text-xl font-semibold text-white">{solution.title}</h3>
              <p class="mt-3 leading-relaxed text-steel">{solution.summary}</p>
              <p class="mt-5 border-l border-cyan/40 pl-4 text-sm leading-relaxed text-white/80">{solution.outcome}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding" id="case-studies">
    <div class="container-custom">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between reveal">
        <div class="max-w-3xl">
          <p class="eyebrow">Selected experience</p>
          <h2 class="section-title">Evidence from complex delivery environments.</h2>
        </div>
        <a href="/case-studies" class="font-semibold text-cyan transition-colors hover:text-white">All case studies →</a>
      </div>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {caseStudies.map((study, index) => (
          <article class="rounded-lg border border-white/10 bg-white/[0.025] p-7 reveal" style={`transition-delay:${index * 80}ms`}>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cyan">{study.industry}</p>
            <h3 class="mt-4 text-2xl font-semibold leading-snug text-white">{study.title}</h3>
            <div class="mt-6 space-y-5 text-sm leading-relaxed text-steel">
              <div><span class="mb-1 block font-semibold text-white">Challenge</span>{study.challenge}</div>
              <div><span class="mb-1 block font-semibold text-white">Outcome</span>{study.outcome}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-white/10 bg-[#080d25] section-padding" id="partners">
    <div class="container-custom">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="reveal">
          <p class="eyebrow">Technology partnerships</p>
          <h2 class="section-title">A technical partner around the product.</h2>
          <p class="section-copy mt-6">Catdev works with technology vendors that need strong solution engineering, implementation and professional services capabilities around their products.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/partners" class="btn-primary">Partner with Catdev</a>
            <a href="/contact" class="btn-secondary">Start a conversation</a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3 reveal">
          {['Pre-sales engineering', 'Proof of concept', 'Enterprise deployment', 'Integration & migration', 'Customer enablement', 'Lifecycle support'].map((item, index) => (
            <div class="min-h-28 rounded-md border border-white/10 bg-white/[0.03] p-5">
              <span class="font-mono text-xs text-cyan">0{index + 1}</span>
              <p class="mt-3 font-medium text-white">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding" id="engineering-depth">
    <div class="container-custom">
      <div class="max-w-3xl reveal">
        <p class="eyebrow">Proof of engineering depth</p>
        <h2 class="section-title">Working systems across infrastructure, software and operations.</h2>
        <p class="section-copy mt-6">Selected projects demonstrate the cross-domain engineering behind Catdev’s enterprise work.</p>
      </div>
      <div class="mt-12 divide-y divide-white/10 border-y border-white/10">
        {engineeringProjects.map((project, index) => (
          <a href={project.href} class="group grid gap-4 py-7 md:grid-cols-[0.34fr_0.66fr_auto] md:items-center reveal" style={`transition-delay:${index * 70}ms`}>
            <div><p class="text-2xl font-semibold text-white group-hover:text-cyan">{project.name}</p><p class="mt-1 text-sm text-cyan">{project.discipline}</p></div>
            <p class="leading-relaxed text-steel">{project.summary}</p>
            <span class="text-xl text-steel group-hover:text-white" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="container-custom">
      <div class="enterprise-grid rounded-lg border border-cyan/20 bg-deep-space/70 p-8 md:p-12 reveal">
        <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
          <div>
            <p class="eyebrow">Start a conversation</p>
            <h2 class="text-3xl font-semibold tracking-tight text-white md:text-4xl">Bring architecture, implementation and operations into one technical conversation.</h2>
          </div>
          <a href="/contact" class="btn-primary whitespace-nowrap">Discuss your requirements</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
